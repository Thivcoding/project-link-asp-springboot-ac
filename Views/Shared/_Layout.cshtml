<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8" />

    <meta http-equiv="X-UA-Compatible"
          content="IE=edge" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        @ViewBag.Title - Legacy Admin
    </title>


    <!-- Bootstrap 3.3.2 -->
    <link rel="stylesheet"
          href="~/Content/AdminLTE/bootstrap/css/bootstrap.min.css" />


    <!-- Font Awesome 4.3.0 -->
    <link rel="stylesheet"
          href="https://maxcdn.bootstrapcdn.com/font-awesome/4.3.0/css/font-awesome.min.css" />

    <!-- Ionicons 2.0.0 -->
    <link rel="stylesheet"
          href="http://code.ionicframework.com/ionicons/2.0.0/css/ionicons.min.css" />


    <!-- AdminLTE -->
    <link rel="stylesheet"
          href="~/Content/AdminLTE/dist/css/AdminLTE.min.css" />


    <!-- AdminLTE Skin -->
    <link rel="stylesheet"
          href="~/Content/AdminLTE/dist/css/skins/skin-blue.min.css" />


    @RenderSection("styles", required: false)

</head>


<body class="skin-blue sidebar-mini">

    <div class="wrapper">


        <!-- Navbar -->
        @Html.Partial("_Navbar")


        <!-- Sidebar -->
        @Html.Partial("_Sidebar")


        <!-- Content Wrapper -->
        <div class="content-wrapper">

            <!-- Content Header -->
            <section class="content-header">

                <h1>

                    @ViewBag.Title

                </h1>

            </section>


            <!-- Main Content -->
            <section class="content">

                @RenderBody()

            </section>

        </div>


        <!-- Footer -->
        <footer class="main-footer">

            <div class="pull-right hidden-xs">

                <b>Version</b> 1.0

            </div>

            <strong>
                Copyright &copy; 2026 Legacy Admin.
            </strong>

            All rights reserved.

        </footer>


    </div>


    <!-- =============================================== -->
    <!-- JavaScript -->
    <!-- =============================================== -->
    <!-- jQuery 2.1.3 -->
    <script src="~/Content/AdminLTE/plugins/jQuery/jQuery-2.1.3.min.js"></script>


    <!-- Bootstrap -->
    <script src="~/Content/AdminLTE/bootstrap/js/bootstrap.min.js"></script>


    <!-- AdminLTE -->
    <script src="~/Content/AdminLTE/dist/bootstrap/js/app.min.js"></script>


    @RenderSection("scripts", required: false)

</body>

</html>

